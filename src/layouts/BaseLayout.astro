---
import '../styles/global.css';
interface Props { title?: string; section?: 'memex' | 'workshop' | 'about' | 'home'; }
const { title = 'Memex Terminal', section = 'home' } = Astro.props;
const path = Astro.url.pathname;
const main = [{ label: 'Home', href: '/' }, { label: 'Memex', href: '/memex/library' }, { label: 'Workshop', href: '/workshop' }, { label: 'About', href: '/about' }];
const sub = section === 'memex' ? [{label:'Graph',href:'/memex/graph'},{label:'Library',href:'/memex/library'},{label:'Books',href:'/memex/books'},{label:'Websites',href:'/memex/websites'},{label:'Videos',href:'/memex/videos'},{label:'PDFs',href:'/memex/pdfs'},{label:'Notes',href:'/memex/notes'}] : section === 'workshop' ? [{label:'Portfolio',href:'/workshop'},{label:'Projects',href:'/workshop/projects'}] : section === 'about' ? [{label:'Resume',href:'/about#resume'}] : [];
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="A personal engineering knowledge terminal." /><title>{title}</title><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" /></head>
  <body>
    <header class="hero"><div class="hero-grid"></div><div class="hero-content"><p class="eyebrow">PERSONAL KNOWLEDGE SYSTEM / 01</p><h1>MEMEX <span>TERMINAL</span></h1><p class="hero-copy">Engineering · Programming · Aviation · Projects</p><p class="status"><i></i> STATUS: ONLINE</p></div></header>
    <div class="nav-shell"><nav class="main-nav" aria-label="Main navigation">{main.map(item => <a class={path === item.href || (item.label !== 'Home' && path.startsWith(item.href.split('/')[1] === 'memex' ? '/memex' : item.href)) ? 'active' : ''} href={item.href}>{item.label}</a>)}</nav>{sub.length > 0 && <nav class="sub-nav" aria-label="Section navigation">{sub.map(item => <a class={path === item.href ? 'active' : ''} href={item.href}>{item.label}</a>)}</nav>}</div>
    <main><slot /></main>
    <footer><span>MEMEX / PERSONAL ARCHIVE</span><span>STATIC SYSTEM · v1.0</span></footer>
  </body>
</html>
