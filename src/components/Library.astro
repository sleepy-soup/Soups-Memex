---
import resources from '../data/library.json';
const { type } = Astro.props;
const filtered = type ? resources.filter(r => r.type === type) : resources;
---
<section class="page-panel library-panel"><div class="panel-heading"><div><p class="eyebrow">MEMEX &gt; {type ? type.toUpperCase() : 'LIBRARY'}</p><h2>{type ? `${type.toUpperCase()} INDEX` : 'RESOURCE LIBRARY'}</h2></div><p class="resource-count">RESOURCES: {filtered.length.toString().padStart(3, '0')}</p></div><div class="library-controls"><label class="search-box"><span>MEMEX:/{type || 'library'}&gt;</span><input id="resource-search" type="search" placeholder="search index" autofocus /></label><div class="filters">{['website','pdf','video','book','notes'].map(kind => <a class={type === kind ? 'selected' : ''} href={type === kind ? '/memex/library' : `/memex/${kind === 'book' ? 'books' : kind + 's'}`}>{kind}</a>)}</div></div><div id="resource-list" class="resource-grid">{filtered.map(resource => <article class="resource-card" data-search={`${resource.title} ${resource.description} ${resource.tags.join(' ')}`.toLowerCase()}><p class="card-type">{resource.type}</p><h3>{resource.title}</h3><p>{resource.description}</p><div class="tags">{resource.tags.map(tag => <span>#{tag}</span>)}</div><a class="open-link" href={resource.url} target={resource.url.startsWith('http') ? '_blank' : undefined}>OPEN <b>→</b></a></article>)}</div><p id="empty-state" class="empty-state" hidden>NO RESOURCES MATCH THIS QUERY.</p></section>
<script>
  const input = document.querySelector<HTMLInputElement>('#resource-search'); const cards = [...document.querySelectorAll<HTMLElement>('.resource-card')]; const empty = document.querySelector<HTMLElement>('#empty-state');
  input?.addEventListener('input', () => { const query = input.value.trim().toLowerCase(); let shown = 0; cards.forEach(card => { const match = card.dataset.search?.includes(query); card.hidden = !match; if (match) shown++; }); if (empty) empty.hidden = shown !== 0; });
</script>
