---
import BaseLayout from '../../layouts/BaseLayout.astro'; import resources from '../../data/library.json';
const tags = [...new Set(resources.flatMap(r => r.tags))];
---
<BaseLayout title="Memex / Graph" section="memex"><section class="page-panel graph-panel"><div class="panel-heading"><div><p class="eyebrow">MEMEX &gt; GRAPH</p><h2>KNOWLEDGE MAP</h2></div><p class="resource-count">TAG CLUSTERS: {tags.length.toString().padStart(3, '0')}</p></div><p class="graph-note">RESOURCE NODES ARE CONNECTED BY SHARED TAGS. SELECT A NODE TO INSPECT ITS RELATIONSHIPS.</p><div id="graph" class="graph-canvas" aria-label="Resource relationship graph" role="img"></div><div id="graph-detail" class="graph-detail">SELECT A RESOURCE NODE</div></section><script define:vars={{ resources }}>
const host = document.querySelector('#graph'); const detail = document.querySelector('#graph-detail');
if (host) { const points = resources.map((r, i) => { const a = (Math.PI * 2 * i / resources.length) - Math.PI / 2; const radius = i % 2 ? 37 : 29; return { ...r, x: 50 + Math.cos(a) * radius, y: 50 + Math.sin(a) * radius }; });
let svg = `<svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">`; points.forEach((a, i) => points.slice(i + 1).forEach(b => { if (a.tags.some(tag => b.tags.includes(tag))) svg += `<line x1="${a.x}" y1="${a.y}" x2="${b.x}" y2="${b.y}" />`; })); svg += '</svg>';
host.innerHTML = svg + points.map((p, i) => `<button class="graph-node" style="left:${p.x}%;top:${p.y}%" data-node="${i}" title="${p.title}">${String(i + 1).padStart(2, '0')}</button>`).join(''); host.querySelectorAll('.graph-node').forEach(node => node.addEventListener('click', () => { const item = points[Number(node.getAttribute('data-node'))]; host.querySelectorAll('.graph-node').forEach(n => n.classList.remove('focus')); node.classList.add('focus'); if(detail) detail.textContent = `${item.title.toUpperCase()} / ${item.tags.map(t => '#' + t).join(' ')}`; })); }
</script></BaseLayout>
